# Comic Vine API (required for the galaxy map)
# Free key: https://comicvine.gamespot.com/api/  (non-commercial use)
COMIC_VINE_API_KEY=

# OpenPanel analytics (https://openpanel.dev)
# Client ID is public; used by the browser SDK via NEXT_PUBLIC_
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
# Client secret is server-only (optional — for future server-side events)
# OPENPANEL_CLIENT_SECRET=

# Optional legacy Marvel API (retired — not required)
# MARVEL_PUBLIC_KEY=
# MARVEL_PRIVATE_KEY=
